# Application
PROJECT_NAME="QR Order"
DEBUG=True
ENVIRONMENT=development
## SUPER_ADMIN_PASSWORD
SUPER_ADMIN_PASSWORD="jwp-system-admin"

# 서버 호스트 & 도메인
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Database
POSTGRES_USER=jwp
POSTGRES_PASSWORD=jwp-system
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qrorder

# Security (반드시 운영 환경에서는 32바이트 이상의 임의 문자열로 교체)
SECRET_KEY="generate-strong-random-secret-key-here"
# Production 배포 시 HTTPS 적용 후 True 변경
SESSION_COOKIE_SECURE=False