# Application
PROJECT_NAME=QR Order
DEBUG=False
# HTTPS 적용 전(IP + HTTP)에는 development로 둔다. production/staging은 Secure 쿠키라 HTTP에서 로그인이 안 된다.
ENVIRONMENT=production
SUPER_ADMIN_PASSWORD=change-me-12chars-or-more

# 테이블 QR에 들어갈 고객 접속 주소 (예: https://order.example.com 또는 http://<공인IP>)
PUBLIC_BASE_URL=

# 서버 (nginx 뒤에서 127.0.0.1로만 리슨)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database
POSTGRES_USER=quickorder
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quickorder

# Security: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
